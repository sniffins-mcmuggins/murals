# Copy to .env and adjust as needed for local development.
# All values below are the compose defaults — you only need .env to override them.

# Database (matches docker-compose defaults)
DATABASE_URL=postgres://render:render@localhost:5432/render?sslmode=disable

# MinIO (local S3 equivalent)
MINIO_ACCESS_KEY=renderdev
MINIO_SECRET_KEY=renderdev123
MINIO_BUCKET=render-images

# JWT signing secret — change this to anything locally, must be secret in prod
JWT_SECRET=dev-jwt-secret-change-in-prod

# Log level: debug | info | warn | error
LOG_LEVEL=debug

# Site base URL — used by Stripe Checkout for success/cancel redirects
SITE_BASE_URL=http://localhost:3000

# Stripe billing (E13) — get test keys from https://dashboard.stripe.com/test/apikeys
# Webhook secret from `stripe listen --forward-to localhost:8080/billing/webhook`
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs (create in dashboard → Products → Pricing)
STRIPE_ARTIST_BASIC_ANNUAL_PRICE_ID=
STRIPE_ARTIST_BASIC_MONTH_PRICE_ID=
STRIPE_ARTIST_PRO_ANNUAL_PRICE_ID=
STRIPE_ARTIST_PRO_MONTH_PRICE_ID=
STRIPE_ORG_SETUP_PRICE_ID=
STRIPE_FESTIVAL_MONTH_PRICE_ID=
STRIPE_FESTIVAL_ANNUAL_PRICE_ID=

# Public Stripe price IDs for the web checkout buttons (same values as STRIPE_ARTIST_*_PRICE_ID)
NEXT_PUBLIC_STRIPE_ARTIST_BASIC_ANNUAL=
NEXT_PUBLIC_STRIPE_ARTIST_BASIC_MONTHLY=
NEXT_PUBLIC_STRIPE_ARTIST_PRO_ANNUAL=
NEXT_PUBLIC_STRIPE_ARTIST_PRO_MONTHLY=
